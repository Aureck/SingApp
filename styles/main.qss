/* ======= ESTILO GENERAL ======= */
QMainWindow {
    background-color: #f2f6fa;
}

QTabWidget::pane {
    border: 2px solid #d0dbe8;
    border-radius: 8px;
    background: #ffffff;
    margin: 6px;
}

QTabBar::tab {
    background: #e9f1fb;
    color: #2c3e50;
    padding: 12px 20px;
    font-size: 18px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #3498db;
    color: white;
}

/* ======= BOTONES ======= */
QPushButton {
    background-color: #2980b9;
    color: white;
    font-size: 19px;         
    font-weight: bold;
    border-radius: 10px;
    padding: 10px 16px;
    border: 2px solid #1f5a85;
    min-width: 160px;         
    min-height: 40px;         
}

QPushButton:hover {
    background-color: #3498db;
    border: 2px solid #21618c;
}

QPushButton:pressed {
    background-color: #2471a3;
}


/* ======= ETIQUETAS ======= */
QLabel {
    font-size: 20px;
    color: #2c3e50;
}

/* ======= CAMPOS DE TEXTO ======= */
QLineEdit, QTextEdit {
    font-size: 18px;
    border: 2px solid #cfd8e3;
    border-radius: 10px;
    padding: 8px;
    background-color: #ffffff;
    color: #2c3e50;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #3498db;
}

/* ======= LISTAS ======= */
QListWidget {
    font-size: 18px;
    background-color: #ffffff;
    border: 2px solid #d0dbe8;
    border-radius: 10px;
}

/* ======= CHECKBOX ======= */
QCheckBox {
    font-size: 18px;
    color: #2c3e50;
}

/* ======= PESTAÑAS (TABS) ======= */
QTabBar::tab {
    background: #e9f1fb;
    color: #2c3e50;
    padding: 10px 24px;         
    font-size: 18px;
    font-weight: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 3px;
    min-width: 130px;           
    min-height: 36px;
}

QTabBar::tab:selected {
    background: #3498db;
    color: white;
}

QTabBar::tab:hover {
    background: #d6eaf8;
}
/* ======= BOTONES COMPACTOS (Responder) ======= */
QPushButton#btnSmall,
QPushButton#btnReply {
    font-size: 15px;
    padding: 6px 10px;
    min-width: 120px;
    min-height: 32px;
    border-radius: 8px;
}

QPushButton#btnSmall:hover,
QPushButton#btnReply:hover {
    background-color: #3fa0e2;
}

QPushButton#btnSmall:pressed,
QPushButton#btnReply:pressed {
    background-color: #1f6ea1;
}
